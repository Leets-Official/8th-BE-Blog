### 공통 설정
@baseUrl = http://localhost:8080
@contentType = application/json

# DataInitializer에서 준비할 회원
@postAuthorAccessToken = REPLACE_WITH_POST_AUTHOR_ACCESS_TOKEN
@commentAuthorAccessToken = REPLACE_WITH_COMMENT_AUTHOR_ACCESS_TOKEN
@adminAccessToken = REPLACE_WITH_ADMIN_ACCESS_TOKEN


### 1. 게시글 작성
# @name createPost
POST {{baseUrl}}/posts
Content-Type: {{contentType}}
Authorization: Bearer {{postAuthorAccessToken}}

{
  "title": "신고 연동 테스트 게시글",
  "content": "신고 처리에 따른 게시글 숨김을 확인합니다."
}

> {%
    client.test("게시글 생성 성공", function() {
        client.assert(response.status === 201, "Expected 201");
    });

    var location = response.headers.valueOf("Location");
    client.global.set("postId", location.split("/").pop());
%}


### 2. 댓글 작성
# @name createComment
POST {{baseUrl}}/posts/{{postId}}/comments
Content-Type: {{contentType}}
Authorization: Bearer {{commentAuthorAccessToken}}

{
  "content": "신고 테스트 댓글입니다."
}

> {%
    client.test("댓글 생성 성공", function() {
        client.assert(response.status === 201, "Expected 201");
    });

    client.global.set("commentId", response.body.id);
%}


### 3. 댓글 목록 조회
GET {{baseUrl}}/posts/{{postId}}/comments

> {%
    client.test("댓글 목록 조회 성공", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.length > 0, "Expected at least one comment");
    });
%}


### 4. 댓글 단건 조회
GET {{baseUrl}}/posts/{{postId}}/comments/{{commentId}}

> {%
    client.test("댓글 단건 조회 성공", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(
            response.body.id == client.global.get("commentId"),
            "Expected the requested comment"
        );
    });
%}


### 5. 게시글 신고
# 댓글 작성자(2)가 게시글 작성자(1)의 게시글을 신고
# @name reportPost
POST {{baseUrl}}/reports
Content-Type: {{contentType}}
Authorization: Bearer {{commentAuthorAccessToken}}

{
  "postId": {{postId}},
  "reason": "게시글 신고 연동 테스트"
}

> {%
    client.test("게시글 신고 생성 성공", function() {
        client.assert(response.status === 201, "Expected 201");
    });

    client.global.set("postReportId", response.body.id);
%}


### 6. 동일 게시글 중복 신고
POST {{baseUrl}}/reports
Content-Type: {{contentType}}
Authorization: Bearer {{commentAuthorAccessToken}}

{
  "postId": {{postId}},
  "reason": "중복 신고 테스트"
}

> {%
    client.test("중복 신고 거절", function() {
        client.assert(response.status === 409, "Expected 409");
    });
%}


### 7. 본인 게시글 신고 거절
POST {{baseUrl}}/reports
Content-Type: {{contentType}}
Authorization: Bearer {{postAuthorAccessToken}}

{
  "postId": {{postId}},
  "reason": "본인 게시글 신고 테스트"
}

> {%
    client.test("본인 콘텐츠 신고 거절", function() {
        client.assert(response.status === 400, "Expected 400");
    });
%}


### 8. 댓글 신고
# 게시글 작성자(1)가 댓글 작성자(2)의 댓글을 신고
# @name reportComment
POST {{baseUrl}}/reports
Content-Type: {{contentType}}
Authorization: Bearer {{postAuthorAccessToken}}

{
  "commentId": {{commentId}},
  "reason": "댓글 신고 연동 테스트"
}

> {%
    client.test("댓글 신고 생성 성공", function() {
        client.assert(response.status === 201, "Expected 201");
    });

    client.global.set("commentReportId", response.body.id);
%}


### 9. 본인 댓글 신고 거절
POST {{baseUrl}}/reports
Content-Type: {{contentType}}
Authorization: Bearer {{commentAuthorAccessToken}}

{
  "commentId": {{commentId}},
  "reason": "본인 댓글 신고 테스트"
}

> {%
    client.test("본인 댓글 신고 거절", function() {
        client.assert(response.status === 400, "Expected 400");
    });
%}


### 10. 운영자 신고 목록 조회
GET {{baseUrl}}/admin/reports?status=PENDING&page=1&size=10
Authorization: Bearer {{adminAccessToken}}

> {%
    client.test("운영자 신고 목록 조회 성공", function() {
        client.assert(response.status === 200, "Expected 200");
    });
%}


### 11. 일반 회원의 운영자 API 접근 거절
GET {{baseUrl}}/admin/reports?status=PENDING&page=1&size=10
Authorization: Bearer {{postAuthorAccessToken}}

> {%
    client.test("일반 회원 접근 거절", function() {
        client.assert(response.status === 403, "Expected 403");
    });
%}


### 12. 게시글 신고 승인 및 콘텐츠 숨김
PATCH {{baseUrl}}/admin/reports/{{postReportId}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminAccessToken}}

{
  "status": "RESOLVED"
}

> {%
    client.test("게시글 신고 승인", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.status === "RESOLVED", "Expected RESOLVED");
    });
%}


### 13. 숨겨진 게시글 단건 조회 거절
GET {{baseUrl}}/posts/{{postId}}

> {%
    client.test("숨겨진 게시글 비노출", function() {
        client.assert(response.status === 404, "Expected 404");
    });
%}


### 14. 댓글 신고 승인 및 콘텐츠 숨김
PATCH {{baseUrl}}/admin/reports/{{commentReportId}}
Content-Type: {{contentType}}
Authorization: Bearer {{adminAccessToken}}

{
  "status": "RESOLVED"
}

> {%
    client.test("댓글 신고 승인", function() {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.status === "RESOLVED", "Expected RESOLVED");
    });
%}


### 15. 숨겨진 댓글 단건 조회 거절
GET {{baseUrl}}/posts/{{postId}}/comments/{{commentId}}

> {%
    client.test("숨겨진 댓글 비노출", function() {
        client.assert(response.status === 404, "Expected 404");
    });
%}