### 환경 변수 및 공통 설정
@baseUrl = http://localhost:8080
@contentType = application/json
@authorId = 1
@nonAuthorId = 2


### 1. 성공 케이스

### 1-1. 게시글 생성 (201 Created)
# @name createPost
POST {{baseUrl}}/posts
Content-Type: {{contentType}}
X-Member-Id: {{authorId}}

{
  "title": "게시글 제목",
  "content": "게시글 본문 내용입니다."
}

> {%
    client.test("201 Created - 게시글 생성 성공", function() {
        client.assert(response.status === 201, "Status should be 201");
    });

    if (response.body && response.body.id) {
        client.global.set("createdPostId", response.body.id);
    }

    else if (response.headers.valueOf("Location")) {
        var location = response.headers.valueOf("Location");
        var id = location.split("/").pop();
        client.global.set("createdPostId", id);
    }
%}

### 1-2. 게시글 목록 조회 - 정상 (200 OK)
GET {{baseUrl}}/posts?page=1&size=10&sort=latest

> {%
    client.test("200 OK - 목록 조회 성공", function() {
        client.assert(response.status === 200, "Status should be 200");
    });
%}


### 1-3. 게시글 상세 조회 (200 OK)
GET {{baseUrl}}/posts/{{createdPostId}}

> {%
    client.test("200 OK - 상세 조회 성공", function() {
        client.assert(response.status === 200, "Status should be 200");
    });
%}


### 1-4. 게시글 수정 (200 OK)
PATCH {{baseUrl}}/posts/{{createdPostId}}
Content-Type: {{contentType}}
X-Member-Id: {{authorId}}

{
  "title": "수정된 게시글 제목",
  "content": "수정된 게시글 본문 내용입니다."
}

> {%
    client.test("200 OK - 게시글 수정 성공", function() {
        client.assert(response.status === 200, "Status should be 200");
    });
%}


### 2. 예외 케이스 (Edge Cases & Exception Testing)

### 2-1. 중복 작성 방지 검증 (409 Conflict)
# - 동일 작성자(Member 1)가 3초 이내 동일 제목으로 연속 작성 시 발생
POST {{baseUrl}}/posts
Content-Type: {{contentType}}
X-Member-Id: {{authorId}}

{
  "title": "수정된 게시글 제목",
  "content": "중복 작성 게시글 본문 내용입니다."
}

> {%
    client.test("409 Conflict - 중복 작성 방지", function() {
        client.assert(response.status === 409, "Status should be 409");
    });
%}


### 2-2. [400 Bad Request] 필수 입력값 누락 검증 (@Valid)
POST {{baseUrl}}/posts
Content-Type: {{contentType}}
X-Member-Id: {{authorId}}

{
  "title": "",
  "content": ""
}

> {%
    client.test("400 Bad Request - 필수 입력값 누락", function() {
        client.assert(response.status === 400, "Status should be 400");
    });
%}


### 2-3. [400 Bad Request] 페이지 번호 범위 위반 (page < 1)
GET {{baseUrl}}/posts?page=0&size=10

> {%
    client.test("400 Bad Request - 페이지 번호 범위 위반", function() {
        client.assert(response.status === 400, "Status should be 400");
    });
%}


### 2-4. [400 Bad Request] 페이지 크기 범위 위반 (size > 50)
GET {{baseUrl}}/posts?page=1&size=100

> {%
    client.test("400 Bad Request - 페이지 크기 범위 위반", function() {
        client.assert(response.status === 400, "Status should be 400");
    });
%}


### 2-5. [400 Bad Request] 지원하지 않는 정렬 옵션 요청
GET {{baseUrl}}/posts?page=1&size=10&sort=unknown

> {%
    client.test("400 Bad Request - 정렬 옵션 오류", function() {
        client.assert(response.status === 400, "Status should be 400");
    });
%}


### 2-6. [400 Bad Request] 게시글 ID 타입 변환 에러
GET {{baseUrl}}/posts/abc

> {%
    client.test("400 Bad Request - 게시글 ID 타입 변환 에러", function() {
        client.assert(response.status === 400, "Status should be 400");
    });
%}


### 2-7. [400 Bad Request] 페이지 번호 타입 변환 에러
GET {{baseUrl}}/posts?page=first

> {%
    client.test("400 Bad Request - 페이지 번호 타입 변환 에러", function() {
        client.assert(response.status === 400, "Status should be 400");
    });
%}


### 2-8. [401 Unauthorized] 인증 헤더 누락 검증
POST {{baseUrl}}/posts
Content-Type: {{contentType}}

{
  "title": "인증 없는 작성 시도",
  "content": "게시글 본문 내용입니다."
}

> {%
    client.test("401 Unauthorized - 인증 헤더 누락", function() {
        client.assert(response.status === 401, "Status should be 401");
    });
%}


### 2-9. [403 Forbidden] 작성자가 아닌 타인의 수정 시도 검증
PATCH {{baseUrl}}/posts/{{createdPostId}}
Content-Type: {{contentType}}
X-Member-Id: {{nonAuthorId}}

{
  "title": "타인의 수정 시도",
  "content": "게시글 본문 내용입니다."
}

> {%
    client.test("403 Forbidden - 타인의 수정 거부", function() {
        client.assert(response.status === 403, "Status should be 403");
    });
%}


### 2-10. 게시글 삭제 - Soft Delete (204 No Content)
DELETE {{baseUrl}}/posts/{{createdPostId}}
X-Member-Id: {{authorId}}

> {%
    client.test("204 No Content - 게시글 삭제 성공", function() {
        client.assert(response.status === 204, "Status should be 204");
    });
%}


### 2-11. [404 Not Found] 삭제된 게시글 재조회 검증
GET {{baseUrl}}/posts/{{createdPostId}}

> {%
    client.test("404 Not Found - 삭제된 게시글 재조회 불가", function() {
        client.assert(response.status === 404, "Status should be 404");
    });
%}